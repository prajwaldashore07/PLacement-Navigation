# Managed MySQL connection is supplied as DATABASE_URL by Webdev.
# For local MySQL, set your own private connection URI here.
DATABASE_URL=mysql://user:password@localhost:3306/mits_placement
PORT=3000

# Local plain-HTTP. For public HTTPS Preview/production, set secure=true and sameSite=none.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=12

# Optional first-admin bootstrap. No default account/password is shipped or created.
ADMIN_SEED_EMAIL=admin@example.invalid
ADMIN_SEED_NAME="MITS Placement Administrator"
ADMIN_SEED_PASSWORD=replace-with-a-strong-secret

# Maximum resume size in bytes (default 5 MiB).
MAX_RESUME_BYTES=5242880
