{
  "name": "mits-placement-navigation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "db:migrate": "node --env-file-if-exists=.env database/migrate.js",
    "db:seed": "node --env-file-if-exists=.env database/seed.js",
    "admin:seed": "node --env-file-if-exists=.env database/seed-admin.js",
    "test": "node --test",
    "check": "node --check server/index.js && node --check client/app.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "mysql2": "^3.15.0"
  }
}
